
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_chars
SESSION_SECRET=your_secure_session_encryption_key

# Google Cloud & Google Workspace Integration
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=nss-sa@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google Drive & Google Sheets Database Architecture
# Root folder in Google Drive where NSS unit directories (/NSS-{collegeId}/...) will be automatically provisioned
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id
# Primary Master Google Spreadsheet ID containing the structured sheets
GOOGLE_SHEETS_DATABASE_ID=your_master_google_sheet_id

# Multi-tenant Default College Configuration
DEFAULT_COLLEGE_ID=unit-04-05
